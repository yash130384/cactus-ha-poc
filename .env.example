# Home Assistant Konfiguration
HASS_URL=http://localhost:8123
# Long-Lived Access Token (LLAT) aus Home Assistant (Profil -> Sicherheit -> Langlebige Zugangs-Token)
# Wenn leer, wechselt der Client automatisch in den Mock-Modus.
HASS_TOKEN=

# Mock-Modus: true erzwingt den simulierten Home Assistant Client (kein Live-Token noetig)
MOCK_MODE=true

# Needle 3 Konfiguration
# 0 = Telemetrie deaktiviert (empfohlen fuer Datenschutz & Offline-Betrieb)
NEEDLE_TELEMETRY=0

# Mindest-Konfidenzwert (0.0 bis 1.0) fuer Tool-Ausfuehrung
CONFIDENCE_THRESHOLD=0.40
